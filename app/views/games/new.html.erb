<% if @confirm_mode %>
  <div style="max-width: 500px; margin: 0 auto; background: #f9f9f9; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
    <h1 style="margin-top: 0;">Подтверждение брони</h1>
    
    <div style="font-size: 18px; margin-bottom: 20px;">
      <p><strong>Квест:</strong> Квест <%= @game.quest_id %></p>
      <p><strong>Дата и время:</strong> <%= @game.time.strftime("%d.%m.%Y в %H:%M") %></p>
      <p><strong>Стоимость:</strong> <%= slot_price(@game.time) %> ₽</p>
    </div>

    <%= form_with model: @game, local: true do |f| %>
      <%= f.hidden_field :quest_id %>
      <%= f.hidden_field :time %>
      
      <div style="margin-bottom: 20px;">
        <%= f.label :info, "Оставьте пожелания или комментарии (необязательно):", style: "display: block; margin-bottom: 5px;" %>
        <%= f.text_area :info, rows: 4, style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
      </div>
      
      <div style="display: flex; gap: 10px;">
        <%= f.submit "Забронировать", style: "background: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: bold;" %>
        <%= link_to "Отмена", new_game_path, style: "padding: 10px 20px; background: #ccc; color: black; text-decoration: none; border-radius: 4px; font-size: 16px;" %>
      </div>
    <% end %>
  </div>

<% else %>
  <h1>Бронирование квеста</h1>

  <div style="margin-bottom: 20px; display: flex; gap: 10px;">
    <%= link_to "Расписание на день", new_game_path(view_mode: 'by_date'), data: { turbo: false }, style: "padding: 10px 20px; text-decoration: none; border-radius: 5px; background: #{@view_mode == 'by_date' ? '#2c3e50' : '#e9ecef'}; color: #{@view_mode == 'by_date' ? 'white' : 'black'};" %>
    <%= link_to "Сетка по квестам", new_game_path(view_mode: 'by_quest'), data: { turbo: false }, style: "padding: 10px 20px; text-decoration: none; border-radius: 5px; background: #{@view_mode == 'by_quest' ? '#2c3e50' : '#e9ecef'}; color: #{@view_mode == 'by_quest' ? 'white' : 'black'};" %>
  </div>

  <hr>

  <% if @view_mode == 'by_date' %>
    <div style="margin-bottom: 20px; padding: 10px; background: #e9ecef; border-radius: 5px; display: inline-block;">
      <%= link_to "← Пред. день", new_game_path(view_mode: 'by_date', date: @selected_date - 1.day), data: { turbo: false }, style: "text-decoration: none; color: #0056b3;" %>
      <strong style="margin: 0 20px; font-size: 18px;"><%= @selected_date.strftime("%d.%m.%Y") %></strong>
      <%= link_to "След. день →", new_game_path(view_mode: 'by_date', date: @selected_date + 1.day), data: { turbo: false }, style: "text-decoration: none; color: #0056b3;" %>
    </div>

    <div style="display: flex; gap: 50px;">
      <div style="width: 200px;">
        <h2 style="border-bottom: 2px solid black; padding-bottom: 5px;">Квест 1</h2>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <% @slots_quest_1.each do |time| %>
            <% if time < Time.current + 1.hour %>
              <div style="background: #f1f3f5; color: #6c757d; padding: 10px; text-align: center; border-radius: 4px; text-decoration: line-through;">
                <%= time.strftime("%H:%M") %> — Прошло
              </div>
            <% elsif slot_booked?(1, time) %>
              <div style="background: #e0e0e0; color: #666; padding: 10px; text-align: center; border-radius: 4px; text-decoration: line-through;">
                <%= time.strftime("%H:%M") %> — Занято
              </div>
            <% else %>
              <%= link_to new_game_path(quest_id: 1, time: time), data: { turbo: false }, style: "display: block; width: 100%; background: #d4edda; color: #155724; padding: 10px; border: 1px solid #c3e6cb; border-radius: 4px; text-decoration: none; text-align: center; box-sizing: border-box;" do %>
                <strong><%= time.strftime("%H:%M") %></strong><br><%= slot_price(time) %> ₽
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div style="width: 200px;">
        <h2 style="border-bottom: 2px solid black; padding-bottom: 5px;">Квест 2</h2>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <% @slots_quest_2.each do |time| %>
            <% if time < Time.current + 1.hour %>
              <div style="background: #f1f3f5; color: #6c757d; padding: 10px; text-align: center; border-radius: 4px; text-decoration: line-through;">
                <%= time.strftime("%H:%M") %> — Прошло
              </div>
            <% elsif slot_booked?(2, time) %>
              <div style="background: #e0e0e0; color: #666; padding: 10px; text-align: center; border-radius: 4px; text-decoration: line-through;">
                <%= time.strftime("%H:%M") %> — Занято
              </div>
            <% else %>
              <%= link_to new_game_path(quest_id: 2, time: time), data: { turbo: false }, style: "display: block; width: 100%; background: #d4edda; color: #155724; padding: 10px; border: 1px solid #c3e6cb; border-radius: 4px; text-decoration: none; text-align: center; box-sizing: border-box;" do %>
                <strong><%= time.strftime("%H:%M") %></strong><br><%= slot_price(time) %> ₽
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

  <% else %>
    <div style="margin-bottom: 20px;">
      <strong style="font-size: 18px;">Выберите квест:</strong>
      <%= link_to "Квест 1", new_game_path(view_mode: 'by_quest', quest_id: 1, start_date: @start_date), data: { turbo: false }, style: "margin-left: 15px; text-decoration: none; padding: 5px 10px; background: #{@selected_quest == 1 ? '#007bff' : '#eee'}; color: #{@selected_quest == 1 ? 'white' : 'black'}; border-radius: 3px;" %> 
      <%= link_to "Квест 2", new_game_path(view_mode: 'by_quest', quest_id: 2, start_date: @start_date), data: { turbo: false }, style: "margin-left: 5px; text-decoration: none; padding: 5px 10px; background: #{@selected_quest == 2 ? '#007bff' : '#eee'}; color: #{@selected_quest == 2 ? 'white' : 'black'}; border-radius: 3px;" %>
    </div>

    <div style="margin-bottom: 20px; padding: 10px; background: #e9ecef; border-radius: 5px; display: inline-block;">
      <%= link_to "← Пред. дни", new_game_path(view_mode: 'by_quest', quest_id: @selected_quest, start_date: @start_date - 7.days), data: { turbo: false }, style: "text-decoration: none; color: #0056b3;" %>
      <strong style="margin: 0 20px; font-size: 18px;">Даты с <%= @start_date.strftime("%d.%m.%Y") %></strong>
      <%= link_to "След. дни →", new_game_path(view_mode: 'by_quest', quest_id: @selected_quest, start_date: @start_date + 7.days), data: { turbo: false }, style: "text-decoration: none; color: #0056b3;" %>
    </div>

    <div style="display: flex; gap: 15px; overflow-x: auto; padding-bottom: 15px;">
      <% @weekly_slots.each do |date, slots| %>
        <div style="min-width: 140px;">
          <h3 style="text-align: center; border-bottom: 2px solid black; padding-bottom: 5px; margin-top: 0;"><%= date.strftime("%d.%m") %></h3>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <% slots.each do |time| %>
              <% if time < Time.current + 1.hour %>
                <div style="background: #f1f3f5; color: #6c757d; padding: 10px; text-align: center; border-radius: 4px; text-decoration: line-through; font-size: 14px;">
                  <%= time.strftime("%H:%M") %><br>Прошло
                </div>
              <% elsif slot_booked?(@selected_quest, time) %>
                <div style="background: #e0e0e0; color: #666; padding: 10px; text-align: center; border-radius: 4px; text-decoration: line-through; font-size: 14px;">
                  <%= time.strftime("%H:%M") %><br>Занято
                </div>
              <% else %>
                <%= link_to new_game_path(quest_id: @selected_quest, time: time), data: { turbo: false }, style: "display: block; width: 100%; background: #d4edda; color: #155724; padding: 10px; border: 1px solid #c3e6cb; border-radius: 4px; text-decoration: none; text-align: center; font-size: 14px; box-sizing: border-box;" do %>
                  <strong><%= time.strftime("%H:%M") %></strong><br><%= slot_price(time) %> ₽
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <br><br>
  <%= link_to "Назад в личный кабинет", dashboard_path, data: { turbo: false } %>
<% end %>