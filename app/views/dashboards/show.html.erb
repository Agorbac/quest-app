<div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
  <h1 class="h2 mb-0">Личный кабинет</h1>
  <div class="text-end">
    <span class="text-muted d-block small">ID: <strong><%= @user.id %></strong></span>
    <span class="badge bg-secondary"><%= @user.role %></span>
  </div>
</div>

<div class="row g-4 mb-5">
  <!-- Блок "Мои бронирования" (Для всех) -->
  <div class="col-12 col-lg-<%= (@user.admin? || @user.actor?) ? '6' : '12' %>">
    <div class="card shadow-sm h-100 border-primary border-opacity-25">
      <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
        <h3 class="h5 mb-0 text-primary">Мои игры</h3>
        <%= link_to "Новая бронь", new_game_path, data: { turbo: false }, class: "btn btn-sm btn-primary fw-bold" %>
      </div>
      <div class="card-body p-0">
        <% if @my_games.any? %>
          <div class="list-group list-group-flush">
            <% @my_games.each do |game| %>
              <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div>
                  <strong class="d-block text-dark"><%= game.quest.name %></strong>
                  <small class="text-muted"><%= game.time.strftime("%d.%m.%Y в %H:%M") %></small>
                </div>
                <%= link_to "Детали", game_path(game), data: { turbo: false }, class: "btn btn-outline-secondary btn-sm" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-4 text-center text-muted">
            У вас пока нет запланированных игр.
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Блок управления (Только для сотрудников) -->
  <% if @user.admin? || @user.actor? %>
    <div class="col-12 col-lg-6">
      <% if @user.admin? %>
        <div class="card shadow-sm h-100 border-danger border-opacity-25">
          <div class="card-header bg-danger bg-opacity-10">
            <h3 class="h5 mb-0 text-danger">Панель Администратора</h3>
          </div>
          <div class="card-body">
            <div class="d-grid gap-2 mb-4">
              <%= link_to "Управление актерами", staff_path, data: { turbo: false }, class: "btn btn-outline-danger fw-bold" %>
              <%= link_to "Таблица мотивации", motivation_path, data: { turbo: false }, class: "btn btn-outline-info text-dark fw-bold" %>
              <%= link_to "Скачать отчет за месяц (PDF)", monthly_report_path(format: :pdf), target: "_blank", class: "btn btn-danger fw-bold" %>
            </div>
            
            <div class="bg-light p-3 rounded border">
              <h4 class="h6 mb-3">Выдача прав доступа</h4>
              <%= form_with url: update_role_path, method: :patch, local: true, class: "row g-2 align-items-end" do |f| %>
                <div class="col-sm-4">
                  <%= f.label :user_id, "ID юзера", class: "form-label small mb-1" %>
                  <%= f.number_field :user_id, required: true, class: "form-control form-control-sm" %>
                </div>
                <div class="col-sm-5">
                  <%= f.label :role, "Роль", class: "form-label small mb-1" %>
                  <%= f.select :role, [["Игрок", "player"], ["Актер", "actor"], ["Админ", "admin"]], {}, class: "form-select form-select-sm" %>
                </div>
                <div class="col-sm-3">
                  <%= f.submit "ОК", class: "btn btn-primary btn-sm w-100" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card shadow-sm h-100 border-warning border-opacity-50">
          <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0 text-dark">Смены и отчеты</h3>
            <%= link_to "Мотивация", motivation_path, data: { turbo: false }, class: "btn btn-sm btn-outline-dark" %>
          </div>
          <div class="card-body p-0">
            <% if @actor_booked_games.any? %>
              <div class="list-group list-group-flush">
                <% @actor_booked_games.each do |game| %>
                  <div class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <strong class="text-dark"><%= game.quest.name %></strong>
                      <span class="badge bg-light text-dark border"><%= game.time.strftime("%d.%m.%Y %H:%M") %></span>
                    </div>
                    
                    <% if game.time < Time.current %>
                      <% if game.report.present? %>
                         <div class="text-end"><%= link_to "Смотреть отчет", game_report_path(game), data: { turbo: false }, class: "text-success text-decoration-none small fw-bold" %></div>
                      <% else %>
                         <div class="text-end"><%= link_to "Заполнить отчет", new_game_report_path(game), data: { turbo: false }, class: "text-danger text-decoration-none small fw-bold" %></div>
                      <% end %>
                    <% else %>
                      <div class="text-end text-success small">Предстоит</div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% else %>
               <div class="p-4 text-center text-muted">Нет предстоящих смен.</div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
<% if @user.admin? %>
  <div class="row g-4 mb-5">
    <div class="col-md-7">
      <div class="card shadow-sm h-100 border-0 bg-white">
        <div class="card-header bg-white border-bottom-0 pt-3">
          <h5 class="mb-0 text-dark">Доход за последние 7 дней</h5>
        </div>
        <div class="card-body">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>
    <div class="col-md-5">
      <div class="card shadow-sm h-100 border-0 bg-white">
        <div class="card-header bg-white border-bottom-0 pt-3">
          <h5 class="mb-0 text-dark">Популярность квестов</h5>
        </div>
        <div class="card-body d-flex justify-content-center">
          <canvas id="popularityChart" style="max-height: 250px;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script>
    function renderCharts() {
      // Уничтожаем старые графики, если они зависли в памяти
      let chart1 = Chart.getChart("revenueChart");
      if (chart1) chart1.destroy();
      let chart2 = Chart.getChart("popularityChart");
      if (chart2) chart2.destroy();

      const ctxRev = document.getElementById('revenueChart');
      if (ctxRev) {
        new Chart(ctxRev.getContext('2d'), {
          type: 'bar',
          data: {
            labels: <%= raw @revenue_by_day.keys.to_json %>,
            datasets: [{
              label: 'Выручка (₽)',
              data: <%= raw @revenue_by_day.values.to_json %>,
              backgroundColor: 'rgba(40, 167, 69, 0.6)',
              borderColor: 'rgba(40, 167, 69, 1)',
              borderWidth: 1,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            scales: { y: { beginAtZero: true } }
          }
        });
      }

      const ctxPop = document.getElementById('popularityChart');
      if (ctxPop) {
        new Chart(ctxPop.getContext('2d'), {
          type: 'doughnut',
          data: {
            labels: <%= raw @games_by_quest.keys.to_json %>,
            datasets: [{
              data: <%= raw @games_by_quest.values.to_json %>,
              backgroundColor: ['#ff9999', '#66b3ff', '#99ff99', '#ffcc99', '#c2c2f0', '#ffb3e6', '#c4e17f', '#76D7C4'],
              borderWidth: 0
            }]
          },
          options: { responsive: true }
        });
      }
    }


    renderCharts();
  </script>
<% end %>
<!-- Рекомендации для игрока -->
<% if @user.player? && @recommended_quests.any? %>
  <div class="mb-5">
    <h2 class="h4 text-warning mb-3 fw-bold">✨ Рекомендуем вам</h2>
    <div class="row flex-nowrap overflow-auto pb-2 g-3">
      <% @recommended_quests.each do |quest| %>
        <div class="col-auto" style="width: 280px;">
          <div class="card h-100 shadow-sm border-warning border-opacity-25">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-dark"><%= quest.name %></h5>
              <p class="card-text small text-muted flex-grow-1" style="height: 60px; overflow: hidden;"><%= quest.info.truncate(80) %></p>
              <div class="mb-3" style="height: 25px; overflow: hidden;">
                <% quest.tags.limit(3).each do |tag| %>
                  <span class="badge bg-info text-dark fw-normal me-1"><%= tag.name %></span>
                <% end %>
              </div>
              <%= link_to "Смотреть расписание", new_game_path(view_mode: 'by_quest', quest_id: quest.id), data: { turbo: false }, class: "btn btn-warning text-dark fw-bold w-100 mt-auto" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Служебная сетка бронирований (Только для сотрудников) -->
<% if @user.admin? || @user.actor? %>
  <div class="card shadow-sm border-0 bg-light">
    <div class="card-body p-4">
      <h3 class="h4 mb-4">Служебная сетка бронирований</h3>
      
      <ul class="nav nav-pills mb-4">
        <li class="nav-item">
          <%= link_to "На день", dashboard_path(view_mode: 'by_date'), data: { turbo: false }, class: "nav-link #{@view_mode == 'by_date' ? 'active bg-dark' : 'text-dark'}" %>
        </li>
        <li class="nav-item ms-2">
          <%= link_to "По квестам", dashboard_path(view_mode: 'by_quest'), data: { turbo: false }, class: "nav-link #{@view_mode == 'by_quest' ? 'active bg-dark' : 'text-dark'}" %>
        </li>
      </ul>

      <% if @view_mode == 'by_date' %>
        <div class="d-flex align-items-center mb-4">
          <%= link_to "← Пред. день", dashboard_path(view_mode: 'by_date', date: @selected_date - 1.day), data: { turbo: false }, class: "btn btn-sm btn-outline-primary" %>
          <strong class="mx-3 fs-5"><%= @selected_date.strftime("%d.%m.%Y") %></strong>
          <%= link_to "След. день →", dashboard_path(view_mode: 'by_date', date: @selected_date + 1.day), data: { turbo: false }, class: "btn btn-sm btn-outline-primary" %>
        </div>

        <div class="row flex-nowrap overflow-auto pb-3">
          <% @quests.each do |quest| %>
            <div class="col-auto" style="min-width: 180px;">
              <div class="card border-0 bg-white h-100 shadow-sm">
                <div class="card-header bg-white border-0 text-center pb-0">
                  <h6 class="text-truncate mb-2" title="<%= quest.name %>"><%= quest.name %></h6>
                  <hr class="mt-0 border-secondary">
                </div>
                <div class="card-body pt-0 d-flex flex-column gap-2 p-2">
                  <% @daily_slots[quest.id].each do |time| %>
                    <% game = get_game_for_slot(quest.id, time) %>
                    <% actors = get_actors_for_shift(quest.id, time.to_date).join(", ") %>
                    
                    <div class="p-2 border rounded text-center small position-relative 
                        <%= game ? (time < Time.current ? 'bg-light border-secondary text-muted' : 'bg-danger bg-opacity-10 border-danger text-danger') : (time < Time.current + 1.hour ? 'bg-light text-muted' : 'bg-success bg-opacity-10 border-success text-success') %>">
                      
                      <strong class="d-block"><%= time.strftime("%H:%M") %></strong>
                      <span style="font-size: 10px; color: purple;" class="d-block text-truncate"><%= actors.presence || "—" %></span>
                      
                      <% if @user.admin? && game %>
                        <div class="mt-1 border-top pt-1">
                          <%= link_to (time < Time.current ? "Детали" : "Управл."), game_path(game), data: { turbo: false }, class: "text-decoration-none fw-bold text-dark" %>
                        </div>
                      <% elsif !game && time >= Time.current + 1.hour %>
                         <div class="mt-1 border-top pt-1">
                           <%= link_to "Свободно", new_game_path(quest_id: quest.id, time: time), data: { turbo: false }, class: "text-success text-decoration-none fw-bold" %>
                         </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

      <% else %>
        <div class="mb-4 d-flex flex-wrap gap-2">
          <% Quest.order(:id).each do |q| %>
            <%= link_to q.name, dashboard_path(view_mode: 'by_quest', quest_id: q.id, start_date: @start_date), data: { turbo: false }, class: "btn btn-sm #{@selected_quest == q.id ? 'btn-primary' : 'btn-outline-secondary'}" %> 
          <% end %>
        </div>

        <div class="d-flex align-items-center mb-4">
          <%= link_to "← Пред. дни", dashboard_path(view_mode: 'by_quest', quest_id: @selected_quest, start_date: @start_date - 7.days), data: { turbo: false }, class: "btn btn-sm btn-outline-primary" %>
          <strong class="mx-3 fs-5">Даты с <%= @start_date.strftime("%d.%m.%Y") %></strong>
          <%= link_to "След. дни →", dashboard_path(view_mode: 'by_quest', quest_id: @selected_quest, start_date: @start_date + 7.days), data: { turbo: false }, class: "btn btn-sm btn-outline-primary" %>
        </div>

        <div class="row flex-nowrap overflow-auto pb-3">
          <% @weekly_slots.each do |date, slots| %>
            <div class="col-auto" style="min-width: 140px;">
              <div class="card border-0 bg-white h-100 shadow-sm">
                <div class="card-header bg-white border-0 text-center pb-0">
                  <h6 class="mb-2"><%= date.strftime("%d.%m") %></h6>
                  <hr class="mt-0 border-secondary">
                </div>
                <div class="card-body pt-0 d-flex flex-column gap-2 p-2">
                  <% slots.each do |time| %>
                    <% game = get_game_for_slot(@selected_quest, time) %>
                    <% actors = get_actors_for_shift(@selected_quest, time.to_date).join(", ") %>

                    <div class="p-2 border rounded text-center small position-relative 
                        <%= game ? (time < Time.current ? 'bg-light border-secondary text-muted' : 'bg-danger bg-opacity-10 border-danger text-danger') : (time < Time.current + 1.hour ? 'bg-light text-muted' : 'bg-success bg-opacity-10 border-success text-success') %>">
                      
                      <strong class="d-block"><%= time.strftime("%H:%M") %></strong>
                      <span style="font-size: 10px; color: purple;" class="d-block text-truncate"><%= actors.presence || "—" %></span>
                      
                      <% if @user.admin? && game %>
                        <div class="mt-1 border-top pt-1">
                          <%= link_to (time < Time.current ? "Детали" : "Управл."), game_path(game), data: { turbo: false }, class: "text-decoration-none fw-bold text-dark" %>
                        </div>
                      <% elsif !game && time >= Time.current + 1.hour %>
                         <div class="mt-1 border-top pt-1">
                           <%= link_to "Свободно", new_game_path(quest_id: @selected_quest, time: time), data: { turbo: false }, class: "text-success text-decoration-none fw-bold" %>
                         </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>