<%= form_with model: @report, url: game_report_path(@game), local: true, html: { multipart: true, id: "report-form" } do |f| %>
  
  <!-- БЛОК ИИ-РАСПОЗНАВАНИЯ -->
  <div class="card border-primary mb-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Автозаполнение по фото бланка</h5>
      <span class="badge bg-light text-primary">Tesseract OCR</span>
    </div>
    <div class="card-body bg-light">
      <div class="row align-items-end">
        <div class="col-md-8">
          <%= label_tag :blank_photo, "Выберите фото бланка для анализа", class: "form-label fw-bold" %>
          <%= file_field_tag :blank_photo, class: "form-control", accept: 'image/*', id: "ocr_file_input" %>
        </div>
        <div class="col-md-4">
          <!-- Кнопка, которая отправит фото на распознавание без сохранения всего отчета -->
          <%= f.submit "Распознать данные", name: "analyze_photo", class: "btn btn-outline-primary w-100 mt-3 mt-md-0" %>
        </div>
      </div>
      <div class="form-text mt-2">ИИ попробует найти сумму «На месте» и количество игроков.</div>
    </div>
  </div>

  <!-- ИНФОРМАЦИЯ О КВЕСТЕ -->
  <div class="alert alert-secondary mb-4">
    <div class="row">
      <div class="col-sm-6"><strong>Квест:</strong> <%= @game.quest.name %></div>
      <div class="col-sm-6 text-sm-end"><strong>Время:</strong> <%= @game.time.strftime("%d.%m.%Y в %H:%M") %></div>
    </div>
  </div>

  <div class="row">
    <!-- ЛЕВАЯ КОЛОНКА -->
    <div class="col-md-6">
      <div class="mb-3">
        <%= f.label :source_type, "Откуда игра", class: "form-label" %>
        <%= f.select :source_type, [["Мир Квестов", "mk"], ["Бронь компании", "bk"]], { prompt: "Выберите..." }, id: "source_type_select", class: "form-select" %>
      </div>

      <div id="mk_sources" class="mb-3" style="display: none;">
        <%= f.label :source_name, "Площадка МК", class: "form-label" %>
        <%= f.select :source_name, ["Мир Квестов", "Топ Квестов", "Квест Хантер", "Яндекс Афиша", "Не знаю"], { prompt: "Выберите..." }, class: "form-select" %>
      </div>

      <div class="mb-3">
        <label class="form-label d-block">Актер</label>
        <div class="d-flex align-items-center gap-3">
          <span><%= current_user.name %></span>
          <button type="button" id="btn_replace_actor" class="btn btn-sm btn-outline-secondary">Замена</button>
        </div>
        <div id="replace_actor_block" class="mt-2" style="display: none;">
          <%= f.collection_select :actual_actor_id, @actors, :id, :name, { prompt: "Кто проводил?" }, class: "form-select" %>
        </div>
      </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА -->
    <div class="col-md-6">
      <div class="mb-3">
        <%= f.label :payment_method, "Способ оплаты", class: "form-label" %>
        <%= f.select :payment_method, ["Терминал", "Наличные", "Перевод"], { prompt: "Выберите..." }, class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :players_count, "Количество человек", class: "form-label fw-bold" %>
        <%= f.number_field :players_count, id: "players_count", min: 1, class: "form-control border-primary" %>
      </div>

      <div class="mb-3">
        <%= f.label :discount_type, "Скидка", class: "form-label" %>
        <%= f.select :discount_type, [["Нет", "0"], ["500 руб", "500"], ["1000 руб", "1000"], ["Другое", "other"]], { prompt: "Выберите..." }, id: "discount_type", class: "form-select" %>
      </div>

      <div id="custom_discount_block" class="mb-3" style="display: none;">
        <%= f.label :discount_custom, "Своя скидка (руб)", class: "form-label" %>
        <%= f.number_field :discount_custom, id: "discount_custom", min: 0, class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="form-check form-switch mb-3">
        <%= f.check_box :photo_sold, id: "photo_sold", class: "form-check-input" %>
        <%= f.label :photo_sold, "Продано фото?", class: "form-check-label" %>
      </div>

      <div id="photo_payment_block" class="mb-3" style="display: none;">
        <%= f.label :photo_payment, "Оплата за фото", class: "form-label" %>
        <%= f.select :photo_payment, ["Терминал", "Наличные"], { prompt: "Выберите..." }, class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :extra_expenses, "Доп расходы (руб)", class: "form-label" %>
        <%= f.number_field :extra_expenses, min: 0, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :comment, "Комментарий", class: "form-label" %>
        <%= f.text_area :comment, rows: 2, class: "form-control" %>
      </div>
    </div>
  </div>

  <!-- РАСЧЕТ И ИТОГ -->
  <div class="card bg-dark text-white mb-4">
    <div class="card-body">
      <button type="button" id="calc_btn" data-base-price="<%= @base_price %>" class="btn btn-warning fw-bold w-100 mb-3">Рассчитать итоговую сумму</button>
      
      <div class="d-flex justify-content-between align-items-center">
        <span>Система насчитала:</span>
        <h4 class="mb-0"><span id="display_calc_amount"><%= @report.calculated_amount || 0 %></span> ₽</h4>
      </div>
      <%= f.hidden_field :calculated_amount, id: "calculated_amount" %>
    </div>
  </div>

  <div id="confirmation_block" style="display: none;" class="p-3 border border-success rounded mb-4">
    <p class="fw-bold text-dark">Сумма совпадает с реальной (из бланка)?</p>
    <div class="btn-group w-100">
      <button type="button" id="btn_match_yes" class="btn btn-success">Да, совпадает</button>
      <button type="button" id="btn_match_no" class="btn btn-outline-danger">Нет, была доплата/скидка</button>
    </div>
  </div>

  <div id="mismatch_block" style="display: none;" class="p-3 border border-danger rounded mb-4 shadow-sm bg-white">
    <div class="mb-3">
      <%= f.label :actual_amount, "Фактическая сумма (сколько взяли по факту)", class: "form-label fw-bold text-danger" %>
      <%= f.number_field :actual_amount, id: "actual_amount", class: "form-control border-danger" %>
    </div>
    
    <div class="mb-3">
      <%= f.label :amount_mismatch_reason, "Причина расхождения", class: "form-label" %>
      <%= f.text_area :amount_mismatch_reason, rows: 2, class: "form-control", placeholder: "Например: доплата за 7-го игрока или опоздание" %>
    </div>
  </div>

  <div id="submit_block" style="display: none;">
    <%= f.submit "Сохранить отчет", class: "btn btn-primary btn-lg w-100 shadow" %>
  </div>
<% end %>

<script>
  document.addEventListener("change", function(e) {
    if (e.target.id === "source_type_select") {
      document.getElementById("mk_sources").style.display = e.target.value === "mk" ? "block" : "none";
    }
    if (e.target.id === "discount_type") {
      document.getElementById("custom_discount_block").style.display = e.target.value === "other" ? "block" : "none";
    }
    if (e.target.id === "photo_sold") {
      document.getElementById("photo_payment_block").style.display = e.target.checked ? "block" : "none";
    }
  });

  document.addEventListener("click", function(e) {
    if (e.target.id === "btn_replace_actor") {
      document.getElementById("replace_actor_block").style.display = "block";
      e.target.style.display = "none";
    }

    if (e.target.id === "calc_btn") {
      const basePrice = parseInt(e.target.getAttribute("data-base-price")) || 0;
      const players = parseInt(document.getElementById("players_count").value) || 0;
      let discount = 0;
      const dType = document.getElementById("discount_type").value;
      
      if (dType === "other") {
        discount = parseInt(document.getElementById("discount_custom").value) || 0;
      } else {
        discount = parseInt(dType) || 0;
      }

      let extraPlayersCost = 0;
      if (players > 4) extraPlayersCost = (players - 4) * 1000;

      let total = basePrice - discount + extraPlayersCost;
      if (total < 0) total = 0;

      document.getElementById("display_calc_amount").innerText = total;
      document.getElementById("calculated_amount").value = total;
      document.getElementById("actual_amount").value = total;
      document.getElementById("confirmation_block").style.display = "block";
    }

    if (e.target.id === "btn_match_yes") {
      document.getElementById("mismatch_block").style.display = "none";
      document.getElementById("submit_block").style.display = "block";
    }

    if (e.target.id === "btn_match_no") {
      document.getElementById("mismatch_block").style.display = "block";
      document.getElementById("submit_block").style.display = "block";
    }
  });
</script>